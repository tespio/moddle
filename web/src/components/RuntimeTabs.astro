---
import { runtimeLabels } from '../lib/models';

interface Props {
  runtimes: Record<string, string>;
}
const { runtimes } = Astro.props;
const entries = Object.entries(runtimes).filter(([, v]) => v);
const id = `tabs-${Math.random().toString(36).slice(2, 8)}`;
---

{
  entries.length > 0 ? (
    <div class="tabs" data-tabs id={id}>
      <div class="tablist" role="tablist">
        {entries.map(([key], i) => (
          <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={i}>
            {runtimeLabels[key] ?? key}
          </button>
        ))}
      </div>
      {entries.map(([, cmd], i) => (
        <div class="tabpanel" role="tabpanel" data-panel={i} hidden={i !== 0}>
          <div class="copy-row">
            <pre><code>{cmd}</code></pre>
            <button class="copy-btn" data-copy={cmd} type="button">Copy</button>
          </div>
        </div>
      ))}
    </div>
  ) : (
    <p class="muted">No runtime commands yet. Contribute one!</p>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((tabs) => {
    const buttons = tabs.querySelectorAll<HTMLButtonElement>('[data-tab]');
    const panels = tabs.querySelectorAll<HTMLElement>('[data-panel]');
    buttons.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b, j) => b.setAttribute('aria-selected', i === j ? 'true' : 'false'));
        panels.forEach((p, j) => (p.hidden = i !== j));
      });
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy || '';
      try {
        await navigator.clipboard.writeText(text);
        const old = btn.textContent;
        btn.textContent = 'Copied';
        btn.classList.add('done');
        setTimeout(() => {
          btn.textContent = old;
          btn.classList.remove('done');
        }, 1600);
      } catch {
        btn.textContent = 'Press Ctrl+C';
      }
    });
  });
</script>
