---
import { credits } from '../lib/models';
---

<section class="section" id="credits">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">● standing on shoulders</span>
        <h2>Credits</h2>
        <p>We index these models; other people did the hard part. Thank you.</p>
      </div>
    </div>

    <div class="credits-list">
      {
        credits.map((c) => (
          <div class={`card${c.featured ? ' featured' : ''}`}>
            <div class="family">{c.featured ? 'Featured · huge thanks' : 'Contributor'}</div>
            <h3>
              {c.name}
              {c.handle && (
                <span class="muted" style="font-weight:500;font-size:.9rem"> {c.handle}</span>
              )}
            </h3>
            <p style="margin:0">
              <strong>{c.role}.</strong> {c.note}
            </p>
            <div class="card-meta">
              <a class="chip chip-strong" href={c.url} target="_blank" rel="noopener noreferrer">
                Visit ↗
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
