---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/site';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={`${entry.data.title} - moddle guide`}>
  <section class="section">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={withBase('/')}>Home</a> <span>/</span>
        <a href={withBase('/docs/')}>Guides</a> <span>/</span> <span>{entry.data.title}</span>
      </nav>

      <article class="prose">
        <h1 style="font-size:clamp(1.8rem,4vw,2.6rem)">{entry.data.title}</h1>
        <Content />
      </article>

      <div class="mt-3">
        <a class="btn btn-ghost btn-sm" href={withBase('/docs/')}>← All guides</a>
      </div>
    </div>
  </section>
</Base>
