---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import RuntimeTabs from '../../components/RuntimeTabs.astro';
import ModelCard from '../../components/ModelCard.astro';
import { models, byCategory, categoryName } from '../../lib/models';
import type { Model } from '../../lib/models';
import { withBase } from '../../lib/site';

export function getStaticPaths() {
  return models.map((model) => ({ params: { slug: model.id }, props: { model } }));
}

interface Props {
  model: Model;
}
const { model } = Astro.props;
const related = byCategory(model.category).filter((m) => m.id !== model.id).slice(0, 3);
const tags = model.tags ?? [];
---

<Base
  title={model.name}
  description={`${model.name}: ${model.summary} Fits a 16 GB GPU at ${model.recommended.quant} (${model.recommended.vram} GB).`}
>
  <section class="section">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={withBase('/')}>Home</a> <span>/</span>
        <a href={withBase(`/categories/${model.category}/`)}>{categoryName(model.category)}</a>
        <span>/</span> <span>{model.name}</span>
      </nav>

      <div class="detail-head">
        <div>
          <div class="family muted">{model.family}</div>
          <h1>{model.name}</h1>
          <div class="spec-strip mt-2">
            <Badge fit={model.fit} />
            <span class="spec-pill"><strong>{model.params}</strong></span>
            {model.context > 0 && (
              <span class="spec-pill"><strong>{model.context.toLocaleString()}</strong> ctx</span>
            )}
            {model.tokps && model.tokps !== 'n/a' && (
              <span class="spec-pill"><strong>{model.tokps}</strong> tok/s est.</span>
            )}
          </div>
        </div>
        <div class="detail-actions">
          <a class="btn btn-ghost btn-sm" href={model.source} target="_blank" rel="noopener noreferrer">
            Model card ↗
          </a>
        </div>
      </div>

      <p class="lede muted" style="font-size:1.05rem;max-width:70ch">{model.summary}</p>

      <div class="grid" style="grid-template-columns:1fr;gap:26px">
        <div class="card">
          <h3>Why it's here</h3>
          <p style="margin:0">{model.why}</p>
        </div>

        <div>
          <div class="section-head"><h2 style="font-size:1.3rem">Run it</h2></div>
          <RuntimeTabs runtimes={model.runtimes} />
        </div>

        <div>
          <div class="section-head"><h2 style="font-size:1.3rem">Quantizations</h2></div>
          <div class="table-wrap">
            <table class="data">
              <thead>
                <tr><th>Quant</th><th>Weights</th><th>Notes</th></tr>
              </thead>
              <tbody>
                {
                  model.quants.map((q) => (
                    <tr>
                      <td><strong>{q.quant}</strong></td>
                      <td>{q.vram} GB</td>
                      <td style="white-space:normal">{q.note}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>

        <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr))">
          <div class="card">
            <div class="family">Recommended</div>
            <h3>{model.recommended.quant}</h3>
            <p style="margin:0">{model.recommended.vram} GB weights{model.recommended.kv8k ? ` · ${model.recommended.kv8k} GB KV @ 8K` : ''}</p>
          </div>
          <div class="card">
            <div class="family">License</div>
            <h3 style="font-size:1rem">{model.license}</h3>
            <p style="margin:0">Check before commercial use.</p>
          </div>
          <div class="card">
            <div class="family">KV per token</div>
            <h3>{model.kvPerTokenMB ?? '—'}{model.kvPerTokenMB ? ' MB' : ''}</h3>
            <p style="margin:0">Multiplies directly with context length.</p>
          </div>
        </div>

        {
          tags.length > 0 && (
            <div class="spec-strip">
              {tags.map((t) => (
                <span class="chip">{t}</span>
              ))}
            </div>
          )
        }

        {
          related.length > 0 && (
            <div>
              <div class="section-head"><h2 style="font-size:1.3rem">More {categoryName(model.category)}</h2></div>
              <div class="grid grid-cards">
                {related.map((m) => (
                  <ModelCard model={m} compact />
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>
</Base>
